root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# 中文文档不做硬换行，靠编辑器软换行即可
trim_trailing_whitespace = false

[*.{html,css,js,json,yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
